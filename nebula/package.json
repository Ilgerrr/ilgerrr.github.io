{
  "name": "nebula",
  "productName": "Nebula",
  "version": "1.0.0",
  "description": "Je Obsidian-vault als levend universum en brein.",
  "main": "main.js",
  "private": true,
  "author": "Ilger",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "install-app": "electron-builder --mac dir --publish never && rm -rf /Applications/Nebula.app && cp -R dist/mac*/Nebula.app /Applications/ && open /Applications/Nebula.app"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ilger.nebula",
    "productName": "Nebula",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "mcp/**",
      "renderer/**",
      "node_modules/three/build/three.module.js",
      "node_modules/three/build/three.core.js",
      "node_modules/three/examples/jsm/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "artifactName": "Nebula-${arch}-mac.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Nebula leest je Obsidian-vault.",
        "NSDownloadsFolderUsageDescription": "Nebula importeert automatisch je Claude-export uit Downloads.",
        "NSDesktopFolderUsageDescription": "Nebula leest je Obsidian-vault."
      }
    },
    "dmg": {
      "title": "Nebula"
    },
    "asarUnpack": [
      "mcp/**",
      "src/**"
    ]
  }
}
